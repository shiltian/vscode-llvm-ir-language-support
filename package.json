{
  "name": "vscode-llvm-ir-language-support",
  "displayName": "VSCode LLVM IR Language Support",
  "description": "Syntax highlighting and language support for LLVM Intermediate Representation (IR) files",
  "version": "1.1.0",
  "publisher": "shiltian",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "llvm",
    "llvm-ir",
    "ir",
    "compiler",
    "syntax highlighting"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/shiltian/vscode-llvm-ir-language-support"
  },
  "license": "Apache-2.0",
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:llvm-ir"
  ],
  "contributes": {
    "languages": [
      {
        "id": "llvm-ir",
        "aliases": [
          "LLVM IR",
          "llvm-ir",
          "LLVM",
          "llvm"
        ],
        "extensions": [
          ".ll"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "llvm-ir",
        "scopeName": "source.llvm-ir",
        "path": "./syntaxes/llvm-ir.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "npm run test:unit",
    "test:unit": "npm run compile && cp src/test/setup.js out/test/ && mocha",
    "test:integration": "npm run compile && node ./out/test/runTest.js",
    "pretest:integration": "npm run compile"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/test-electron": "^2.3.8",
    "glob": "^10.3.10",
    "mocha": "^11.7.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  }
}
